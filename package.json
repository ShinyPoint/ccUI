{
  "name": "ccui",
  "version": "0.1.10",
  "description": "A desktop app for Claude Code: chat sessions with diffs, permissions and a terminal, side by side",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "electron",
    "agent-sdk",
    "desktop",
    "gui"
  ],
  "homepage": "https://github.com/ShinyPoint/ccUI#readme",
  "bugs": {
    "url": "https://github.com/ShinyPoint/ccUI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShinyPoint/ccUI.git"
  },
  "license": "MIT",
  "author": "ccUI contributors",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && node scripts/launch.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node scripts/checks/run.mjs",
    "smoke": "vite build && electron scripts/checks/smoke.js",
    "sdk-check": "node scripts/checks/sdk-check.mjs",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "shots": "vite build && electron scripts/ui-shots.js",
    "icon": "electron scripts/make-icon.js",
    "check:actions": "vite build && electron scripts/checks/message-actions-check.js",
    "check:find": "vite build && electron scripts/checks/find-check.js",
    "check:background": "vite build && electron scripts/checks/background-check.js",
    "check:look": "vite build && electron scripts/checks/chat-look-check.js",
    "check:skills": "vite build && electron scripts/checks/skills-check.js",
    "check:plugins": "vite build && electron scripts/checks/plugins-check.js",
    "check:select": "vite build && electron scripts/checks/select-check.js",
    "check:update": "vite build && electron scripts/checks/update-check.js",
    "check:agents": "vite build && electron scripts/checks/agents-check.js",
    "check:changes": "vite build && electron scripts/checks/changes-check.js",
    "check:dialogs": "vite build && electron scripts/checks/dialogs-check.js",
    "check:commands": "vite build && electron scripts/checks/commands-check.js",
    "check:sessions": "vite build && electron scripts/checks/sessions-check.js",
    "check:sidebar": "vite build && electron scripts/checks/sidebar-check.js",
    "check:effort": "vite build && electron scripts/checks/effort-check.js",
    "check:i18n": "vite build && electron scripts/checks/i18n-check.js",
    "video": "vite build && electron scripts/intro-video/record.js && electron scripts/intro-video/compose.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.15"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.0.14",
    "preact": "^11.0.0",
    "rcedit": "^5.0.2",
    "vite": "^8.3.2"
  },
  "productName": "ccUI",
  "build": {
    "appId": "dev.ccui.app",
    "productName": "ccUI",
    "files": [
      "dist-renderer/**/*",
      "src/main/**/*",
      "src/preload.js",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "node_modules/@anthropic-ai/**"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "ShinyPoint <242611159+ShinyPoint@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "icon": "assets/icon.png",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
