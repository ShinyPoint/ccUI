<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": ccUI.exe on its own, signed before the installers are built around it
     (see .github/workflows/release.yml). electron-builder writes its product version in four parts. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="ccUI.exe" product-name="ccUI" product-version="${version}.0">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
